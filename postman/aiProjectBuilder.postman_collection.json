            },
            "description": "Update a project member's role."
          }
        },
        {
          "name": "Remove Member",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/members/{{memberId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "members", "{{memberId}}"]
            },
            "description": "Remove a member from the project. Returns 204 No Content."
          }
        }
      ]
    },
